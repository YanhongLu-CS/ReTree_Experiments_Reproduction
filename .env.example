# Copy this file to .env and fill in your third-party relay credentials.

# LLM relay. The client expects an OpenAI-compatible /chat/completions endpoint.
LLM_BASE_URL=https://your-relay.example.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=qwen3-8b

# Optional judge model. Leave disabled in configs/default.yaml for smoke tests.
JUDGE_BASE_URL=https://your-relay.example.com/v1
JUDGE_API_KEY=sk-your-judge-key-here
JUDGE_MODEL=gpt-5

# Search relay. Use SEARCH_PROVIDER=custom when your relay exposes a generic JSON endpoint.
SEARCH_PROVIDER=custom
SEARCH_BASE_URL=https://your-search-relay.example.com/search
SEARCH_API_KEY=search-key-here

